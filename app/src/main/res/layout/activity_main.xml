<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/main"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#070707"
  android:padding="24dp"
  tools:context=".MainActivity">

  <ImageView
    android:id="@+id/imgLogo"
    android:layout_width="260dp"
    android:layout_height="360dp"
    android:layout_marginBottom="16dp"
    android:contentDescription="Logo de la empresa"
    android:src="@drawable/cafesplash"
    app:layout_constraintBottom_toTopOf="@id/txtSubtitulo"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintVertical_chainStyle="packed" />

  <TextView
    android:id="@+id/txtSubtitulo"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:text="CAFÉ ARTESANAL - ENTREGA INMEDIATA"
    android:textColor="#FB7800"
    android:textSize="10sp"
    android:textStyle="bold"
    app:layout_constraintBottom_toTopOf="@+id/layoutTitulo"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/imgLogo" />

  <LinearLayout
    android:id="@+id/layoutTitulo"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal"
    app:layout_constraintBottom_toTopOf="@+id/txtDescripcion"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/txtSubtitulo">

    <TextView
      android:id="@+id/txtCafe"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:letterSpacing="0.05"
      android:text="Café "
      android:textColor="#E2E0E0"
      android:textSize="24sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/txtExpress"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:letterSpacing="0.05"
      android:text="Express"
      android:textColor="#FB7800"
      android:textSize="24sp"
      android:textStyle="bold" />

  </LinearLayout>

  <TextView
    android:id="@+id/txtDescripcion"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:paddingHorizontal="14dp"
    android:text="El mejor café nacional y snacks recién horneados en minutos en tu puerta"
    android:textColor="#D3D3D3"
    android:textSize="12sp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/layoutTitulo" />

</androidx.constraintlayout.widget.ConstraintLayout>